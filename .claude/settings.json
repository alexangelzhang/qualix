{
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "basedpyright@claude-code-lsps": true,
    "context-engineering-fundamentals@context-engineering-marketplace": true,
    "skill-creator@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 \"$(git rev-parse --show-toplevel)/qualix/.claude/hooks/ironlaw_guard.py\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 \"$(git rev-parse --show-toplevel)/qualix/.claude/hooks/phase_finalize_reminder.py\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'python3 \"$(git rev-parse --show-toplevel)/qualix/.claude/hooks/ttsr_reminder.py\"'",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'python3 \"$(git rev-parse --show-toplevel)/qualix/.claude/hooks/ttsr_reminder.py\"'",
            "async": true
          }
        ]
      }
    ]
  }
}
