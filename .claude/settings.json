{
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "basedpyright@claude-code-lsps": true,
    "context-engineering-fundamentals@context-engineering-marketplace": true,
    "skill-creator@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/dev-quality-gate/.claude/hooks/inject-journal.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/dev-quality-gate/.claude/hooks/stop-journal-reminder.sh\""
          }
        ]
      }
    ]
  }
}
