metadata:
  service: car-mrs
  domain: 售后维修保养
  mapper_count: 63

# 聚合根
aggregation_roots[9]{name,directory,responsibility}:
  MrPickUpDeliveryAggregation,domain/aggregation/,取送车业务逻辑封装（代驾取车/还车）
  MrReassignOrderAggregation,domain/aggregation/,改派单业务逻辑
  MrTocAuthAggregation,domain/aggregation/,C端权限校验（取消等操作前置校验）
  MrFaultCaseAggregation,domain/aggregation/,故障案例聚合
  MrItemAggregation,domain/aggregation/,服务项聚合
  MrItemGroupAggregation,domain/aggregation/,服务项组聚合
  MrItemOldReplaceAggregation,domain/aggregation/,旧件替换聚合
  MrPartLendPlanAggregation,domain/aggregation/,配件借用计划聚合
  CarAppNoticeInfoAggregation,domain/aggregation/,APP通知信息聚合
  聚合工厂: MrFaultCaseAggregationFactory, MrPickUpDeliveryAggregationFactory, MrTocAuthAggregationFactory

# 领域事件
domain_events[7]{name,directory,trigger}:
  AsyncHandleEvent,domain/event/,异步处理事件
  CarAppNoticeEvent,domain/event/,APP通知事件
  GenSignPdfEvent,domain/event/,生成签字PDF事件
  LendCreateCheckEvent,domain/event/,借件创建校验事件
  MrMessageInformedEvent,domain/event/,消息通知事件（消息中台推送）
  PickUpDeliveryConcatUpsertEvent,domain/event/,取送车联系人更新事件
  PickUpDeliveryOrderCancelEvent,domain/event/,取送车订单取消事件
  PickUpDeliveryUpsertEvent,domain/event/,取送车订单更新事件

# 状态机框架
statemachine_framework:
  core_class: MrStateMachine
  description: 内存级状态校验与扭转，集中管理状态流转规则
  states: 16个状态
  events: 23个事件
  note: 正向主流程+逆向回退+取消，统一状态机管控

# 状态机 - 状态枚举 (MrOrderStatusEnum)
state_machine:
  states[16]{enum,code,chinese,in_store_name,to_door_name}:
    UNKNOWN,-1,待生效,待生效,待生效
    INIT,0,初始状态,待接单,待接单
    PICKUP,10,移动服务已接单,待进店,待出发
    SETOFF,20,移动服务已出发,待到达,上门中
    ARRIVAL,25,移动服务已到达,待环检,待环检
    INSPECTED,40,环检完成,待添服务项,待添加服务项
    INSPECTED_CONFIRMATION,45,待添加维保方案,待添服务项,待添服务项
    ADDED_ITEM,55,添加维保方案完成,待用户确认服务项,待用户确认服务项
    ADDED_ITEM_CONFIRMATION,60,维保方案用户确认完成,待派工,作业中
    DISPATCHED,70,派工完成,作业中,作业中
    WORK_FINISH,75,作业完成,待质检,待质检
    QUALITY_CHECKED,80,质检完成,待验车,待验车
    ACCEPTANCE_FINISH,85,交车验收完成,待申请结算,待申请结算
    SETTLED_ORDER,90,已结算下单,待支付,待支付
    ORDER_PAID,94,待交车,待交车,待交车
    DELIVERY_COMPLETED,97,交车完成,交车完成,交车完成
    COMPLETED,95,已完成,服务完成,已完成
    CANCEL,100,已取消,已取消,已取消

  # 正向主流程
  forward_flow:
    到店: INIT(0)→PICKUP(10)→INSPECTED(40)→ADDED_ITEM(55)→ADDED_ITEM_CONFIRMATION(60)→DISPATCHED(70)→WORK_FINISH(75)→QUALITY_CHECKED(80)→ACCEPTANCE_FINISH(85)→SETTLED_ORDER(90)→ORDER_PAID(94)→DELIVERY_COMPLETED(97)→COMPLETED(95)
    上门: INIT(0)→PICKUP(10)→SETOFF(20)→ARRIVAL(25)→INSPECTED(40)→...（同到店后续）

  # 逆向/回退
  reverse_transitions[3]{from,to,event,description}:
    QUALITY_CHECKED(80),DISPATCHED(70),CHECK_REFUSE,质检不通过回退到派工（移动工单回退到ADDED_ITEM_CONFIRMATION）
    WORK_FINISH(75)/QUALITY_CHECKED(80),WORK_FINISH(75),CHECK_WITHDRAW,返回质检
    高状态,ADDED_ITEM(55)/DISPATCHED(70)/ACCEPTANCE_FINISH(85),ADDED_ITEM,修改服务项回退（按修改类型决定回退目标）

  # 取消规则
  cancel_rule: status code <= DISPATCHED(70)的所有状态均可取消→CANCEL(100)

  # 终态
  terminal_states[2]{state,code}:
    COMPLETED,95
    CANCEL,100

  # 逆向状态处理详细规则
  reverse_rules:
    ADDED_ITEM回退规则[4]{condition,action}:
      待派工/作业中追加,不变更状态
      无修改/修改业务类型,不变更状态
      修改付费类型,未结算不变更/结算后回退到待结算(ACCEPTANCE_FINISH)
      修改工时/配件,回退到作业中(DISPATCHED)/移动工单回退到待派工

# 状态事件枚举 (MrStateEvent) - 23个
state_events[23]{event,chinese,trigger}:
  CREATE_WITH_APPOINT,建单-预约方式,用户通过预约创建工单
  CREATE_NO_APPOINT,建单-非预约方式,直接到店创建工单
  CREATE_ORG_WITH_APPOINT,门店建单-预约方式,门店代客预约建单
  CREATE_WITH_APPOINT_STORE_PROXY_CONFIRM,建单-预约方式-门店代理确认,门店代理确认预约
  RECEIVE,门店接单,门店确认接收工单
  SETOFF,服务车出发,上门服务车辆出发
  ARRIVAL,上门到达,服务车到达用户位置
  IN_STORE,到店接车,车辆到达门店
  INSPECTED,环检,完成车辆环检
  ADDED_ITEM,添加服务项,技师添加维保方案
  CONFIRMATION_ITEM,确认服务项,用户确认维保方案
  DISPATCHED,派工,分配技师开始作业
  WORKED_PARTITION,完成作业-部分完成,部分服务项完成
  WORKED,完成作业-全部完成,所有服务项完成
  CHECK_ACCEPT,质检完成,质检通过
  CHECK_REFUSE,质检不通过,质检不通过回退到派工
  CHECK_WITHDRAW,返回质检,从验车回退到质检
  ACCEPTANCE,验车,车主验车确认
  SETTLED_ORDER,结算下单,生成交易订单
  SELF_PAY,自费完成,用户完成支付
  DELIVERY,交车,车辆交还车主
  CANCEL,取消维保单,取消工单（派工前可取消）
  COMPLETED,维保单完成,工单流程结束

# 核心业务枚举（100+）
api_enums[20]{name,usage}:
  MrOrderStatusEnum,维保单状态（16个状态）
  MrTypeEnum,维保单类型（到店/上门/整备/售前）
  MrOrderTypeEnum,工单类型
  MrItemStatusEnum,服务项状态
  MrItemTypeEnum,服务项类型
  MrItemBizTypeEnum,服务项业务类型
  PayTypeEnum,付费类型
  MrBizTypeEnum,业务类型
  CancelReasonEnum,取消原因
  RefundStatusEnum,退款状态
  RefundProcessEnum,退款流程
  DepositTypeEnum,押金类型
  EquityTypeEnum,权益类型
  BpmApplyEnum,BPM审批类型
  QualityCheckEnum,质检枚举
  FaultCaseStatusEnum,故障案例状态
  RoleEnum/RoleCategoryEnum,角色/角色分类
  ServiceTypeEnum,服务类型
  CategoryEnum,分类枚举
  +80more,其他枚举

domain_enums[6]{name,usage}:
  MrStateEvent,状态机事件（23个事件）
  CarAppNoticeActionEnum,APP通知动作
  CarAppNoticeTemplateEnum,APP通知模板
  AppPushSceneEnum,APP推送场景
  MessageInformedStatusEnum,消息通知状态
  MessagePushChannelEnum,消息推送渠道

# 策略模式（12组）
strategy_groups[12]{factory,directory,usage}:
  CreateMrWorkNoFactory,strategy/createMrWorkNo/,建单策略（到店/上门/到店整备/移动整备/售前5种）
  MessageInformedEventFactory,strategy/notice/,消息通知策略
  MrAdjustPriceFactory,strategy/,调价策略
  AbstractAppPush,strategy/,APP推送模板方法
  签字策略,strategy/sign/,签字流程
  文件策略,strategy/file/,文件处理
  上门策略,strategy/toDoor/,上门服务
  工单列表策略,strategy/,列表展示
  权益策略,strategy/,权益处理
  +3more,strategy/,其他策略

# Mapper清单（63个，列出核心）
mappers_core[8]{name,description}:
  MrOrderMapper,维保单主表
  MrOrderLogMapper,操作日志
  MrCancelRecordMapper,取消记录
  InspectionMapper,环检数据
  MrItemMapper,服务项
  MrRefundRecordMapper,退款记录
  MrReassignOrderMapper,改派单
  +55more,其他Mapper

# MQ消费者（13个）
mq_consumers[13]{name,topic,description}:
  工单状态变更消费者,工单状态变更,消费工单状态变更消息
  交易订单消费者,交易订单,消费交易订单消息
  取送车消费者,取送车,消费取送车相关消息
  调度消费者,调度,消费调度相关消息
  +9more,其他topic,其他MQ消费者

# 定时任务（7个）
nrjob_tasks[7]{name,description}:
  导出类Job(7个),导出相关定时任务

# Spring Event监听器
event_listeners[2]{name,description}:
  状态变更事件监听器,监听状态变更事件执行ES同步
  消息通知事件监听器,监听MrMessageInformedEvent执行消息通知推送

# 转换器
converters:
  app_layer: DTO↔Domain Param转换器（MapStruct）
  infrastructure_layer: DO↔Model转换器
  domain_layer: 领域内转换器
