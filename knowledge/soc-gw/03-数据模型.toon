metadata:
  service: soc-gw
  domain: 客服系统BFF网关
  table_count: 15

# 核心实体
domain_entities[8]{name,layer,description,key_fields}:
  SuperTicketModel,domain/model,超级工单（聚合根）,stNo|superTicketTypeId|superTicketStatus|vid|orgId|soNo
  ServiceOrderModel,domain/model,服务单,soNo|stNo|contactTel|contactMid|templateName
  TCswOrderModel,domain/model,CSW工单（客服工单）,cswOrderNo|stNo|status
  CarSuperTicketModel,domain/model,超级工单DB实体,id|superTicketNo|superTicketTypeId|vid
  TCarWorkOrderRelaModel,domain/model,作业单关联关系,stNo|soNo|workOrderNo|workOrderType
  CarWorkOrderSessionRelationModel,domain/model,工单-会话关联,workOrderNo|sessionId
  HealthLinkOrderBo,domain/model,健康链路工单,orderId|vid|serviceType|status
  TCswEchoReplyModel,domain/model,回声回复,echoId|replyContent

# 表→Mapper映射
table_class_map[15]{name,comment,classes}:
  t_car_super_ticket,超级工单主表,TCarSuperTicketMapper
  t_car_super_ticket_follow,工单跟进记录,TCarSuperTicketFollowMapper
  car_super_ticket_log,工单操作日志,CarSuperTicketLogMapper
  t_csw_order,CSW工单,TCswOrderMapper
  t_csw_order_log,CSW工单日志,TCswOrderLogMapper
  t_csw_echo_reply,回声回复,TCswEchoReplyMapper
  t_cws_urge,催办记录,TCwsUrgeMapper
  (服务单查询),服务单分页查询,ServiceOrderSelectMapper
  t_car_work_order_rela,作业单关联,TCarWorkOrderRelaMapper
  t_car_service_work_order_rela,服务-作业单关联,TCarServiceWorkOrderRelaMapper
  car_work_order_session_relation,工单-会话关联,CarWorkOrderSessionRelationMapper
  (全息任务中心),任务中心查询,HoloTaskCenterMapper
  (MySQL任务中心),任务中心MySQL查询,MySQLTaskCenterMapper
  (申请表),申请记录,ApplyMapper
  (申请凭证),申请凭证,ApplyCertificateMapper

# 策略模式（领域层核心设计）
strategy_hierarchies[3]{name,interface,abstract_base,implementations}:
  WorkOrderQuery策略(工单列表查询):
    interface: WorkOrderQueryStrategy
    base: AbstractWorkOrderQuery
    impls[5]:
      IndoorMrWorkOrderQuery,到店维保工单
      CustomServiceWorkOrderQuery,客服工单
      ProcessingWorkOrderQuery,处理中工单
      RoadRescueWorkOrderQuery,道路救援工单
      CsUpgradeUrgeQuery,客服升级催办
  WorkDetail策略(工单详情差异化查询):
    interface: WorkDetailStrategy
    base: AbstractSuperTicketInfoQuery
    factory: WorkDetailSimpleFactory
    impls[19]:
      CarMrsInfoQuery,预约到店维保/预约移动维保/用户预约到店维保
      RoadRescueInfoQuery,道路救援
      ClaimInfoQuery,理赔
      TecSupportInfoQuery,技术支持
      HealthLinkInfoQuery,健康链路
      EcallTspQuery,紧急呼叫
      ThirdPerformanceQuery,三方履约
      CsEnquireInfoQuery,客服咨询
      CsUpdateInfoQuery,客服升级
      CsConfirmInfoQuery,客服确认
      DispatchInfoQuery,派工
      EchoFeedbackQuery,回声反馈
      CalloutTaskInfoQuery,外呼任务
      CarInspectionAuditQuery,验车审核
      CarOwnerChangeInfoQuery,车主变更
      MajorRiskInfoQuery,重大风险
      CsDdMrInfoQuery,客服到店维保
      CsPointsGrantInfoQuery,客服积分发放
      ...,更多策略
  RemoteDiagnosis策略(远程诊断):
    interface: RemoteDiagnosisWorkOrderDetailStrategy
    base: AbstractRemoteDiagnosisWorkOrderDetailStrategy
    impls[4]:
      CustomerWorkOrderRemoteDiagnosisWorkOrderDetailStrategy,客服工单远程诊断
      MaintenanceWorkOrderRemoteDiagnosisWorkOrderDetailStrategy,维保工单远程诊断
      ServiceOrderRemoteDiagnosisWorkOrderDetailStrategy,服务单远程诊断
      TechSupportWorkOrderRemoteDiagnosisWorkOrderDetailStrategy,技术支持远程诊断

