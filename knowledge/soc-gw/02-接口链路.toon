  API-024,dubbo,ConfigProviderImpl,-
  API-025,dubbo,CommentProviderImpl,-
  API-026,dubbo,HoloTaskCenterProviderImpl,-

# 核心调用链路
call_chains[5]{id,name,complexity,entry}:
  CC-001,超级工单详情查询,最复杂,SuperTicketProvider.superTicketDetail(stNo)
  CC-002,车主APP服务首页,高,CarAppProvider.getCarList()/getAppServiceConfig()/selectStoreListBetaToC()
  CC-003,服务单查询,中,ServiceOrderQueryProvider.serviceOrderList(req)/serviceOrderDetail(req)
  CC-004,呼叫中心工单列表,高,SuperTicketProvider.callCenterSuperTicketList(req)
  CC-005,门店容量监控,中,StoreRepairCapacityCalculateProvider.getStoreRepairCapacity(req)

chain_details:
  CC-001:
    description: 客服查看工单详情时聚合20+种工单类型的差异化数据
    flow:
      SuperTicketProvider.superTicketDetail(stNo)
        -> SuperTicketProviderImpl
          -> SuperTicketDetailService.superTicketDetail(stNo,loginMid)
            -> SuperTicketDetailServiceImpl
              -> SuperTicketRepositoryGateway.findByStNo() [本地DB:工单基础信息]
              -> CisRpcGateway.getCarInfo() [RPC:车辆信息]
              -> CarUserGateway/MiAccountGateway [RPC:车主/用户信息]
              -> ServiceOrderRepositoryGateway.findBySoNo() [本地DB:服务单]
              -> WorkDetailSimpleFactory.getStrategy(ticketTypeId) [策略工厂]
                -> CarMrsInfoQuery -> CarMrsGateway [RPC:维保单详情]
                -> RoadRescueInfoQuery -> RoadRescueGateway [RPC:救援信息]
                -> ClaimInfoQuery -> ClaimRpcGateway [RPC:理赔信息]
                -> TecSupportInfoQuery -> TecSupportGateway [RPC:技术支持]
                -> HealthLinkInfoQuery -> HealthLinkOrderGateway [本地DB:健康链路]
                -> EcallTspQuery -> EcallTspGateway [HTTP:TSP紧急呼叫]
                -> ThirdPerformanceQuery -> ThirdPerformanceGateway [RPC:三方履约]
                -> ...(20+策略)
              -> ComplaintViewGateway.getComplaintDetail() [RPC:投诉信息]
              -> EmployeeGateway.getEmployeeInfo() [RPC:员工信息]
  CC-002:
    description: 车主打开APP服务页聚合车辆列表/门店/预约等信息
    flow:
      CarAppProvider.getCarList()/getAppServiceConfig()/selectStoreListBetaToC()
        -> CarAppProviderImpl
          -> CarAppService.getCarList(mid)/getAppServiceConfig()/selectStoreListBetaToC()
            -> CarAppServiceImpl
              -> CisRpcGateway.getCarRelationList() [RPC:车辆列表]
              -> CisRpcGateway.getSimpleInfo() [RPC:车辆详情]
              -> CarEquityGateway/CarEquityPkgGateway [RPC:权益信息]
              -> StoreProviderGateway.queryAllStoreList() [RPC:门店列表]
              -> MrStoreCapacityCalculateProviderGateway [RPC:门店容量]
              -> MaintenanceReminderGateway [RPC:保养提醒]
              -> ConfigurationsAdminProviderGateway [RPC:配置中心]
  CC-003:
    description: 客服按客户维度查询服务单列表和详情
    flow:
      ServiceOrderQueryProvider.serviceOrderList(req)/serviceOrderDetail(req)
        -> ServiceOrderQueryProviderImpl
          -> ServiceOrderQueryService.queryServiceOrder(req)
            -> ServiceOrderQueryServiceImpl
              -> ServiceOrderRepositoryGateway.selectByParam() [本地DB:分页查询]
              -> CisRpcGateway.getVinRelationMap() [RPC:VIN-VID映射]
              -> WhiteLiteServiceGateway.isTestTag() [RPC:白名单校验]
              -> DataDesensitizaUtil.kcDecrypt() [手机号脱敏解密]
  CC-004:
    description: 呼叫中心查看客户工单列表前3个进行中工单并发补充详情
    flow:
      SuperTicketProvider.callCenterSuperTicketList(req)
        -> SuperTicketProviderImpl
          -> SuperTicketService.comstomerSuperTicketList(req)
            -> SuperTicketRepositoryGateway.findByCustomer() [本地DB]
          -> fillProcessingDetail() [并发填充:CompletableFuture+线程池]
            -> [前3个DOING/WAIT_RESPONSE工单]
              -> SuperTicketDetailService.superTicketDetail() [复用CC-001链路]
  CC-005:
    description: 门店维修容量的计算和监控
    flow:
      StoreRepairCapacityCalculateProvider.getStoreRepairCapacity(req)
        -> StoreRepairCapacityCalculateProviderImpl
          -> StoreRepairCapacityCalculateService.calculate()
            -> StoreRepairCapacityCalculateServiceImpl
              -> StoreRepairCapacityDataGateway.getCapacityData() [RPC:容量基础数据]
              -> MrStoreCapacityCalculateProviderGateway [RPC:MRS容量计算]
              -> SuperTicketService.storeActualCapacityList() [本地DB:在修工单]
              -> StoreProviderGateway.getStoreInfo() [RPC:门店信息]

# 策略模式
strategy_patterns[3]{name,interface,base_class,strategies}:
  工单列表查询,WorkOrderQueryStrategy,AbstractWorkOrderQuery,IndoorMrWorkOrderQuery(到店维保)|CustomServiceWorkOrderQuery(客服工单)|ProcessingWorkOrderQuery(处理中工单)|RoadRescueWorkOrderQuery(道路救援)|CsUpgradeUrgeQuery(客服升级催办)
  工单详情差异化查询,WorkDetailStrategy,AbstractSuperTicketInfoQuery,CarMrsInfoQuery|RoadRescueInfoQuery|ClaimInfoQuery|TecSupportInfoQuery|HealthLinkInfoQuery|EcallTspQuery|ThirdPerformanceQuery|DispatchInfoQuery|EchoFeedbackQuery|CsEnquireInfoQuery|CsUpdateInfoQuery|CsConfirmInfoQuery|CalloutTaskInfoQuery|CarInspectionAuditQuery|CarOwnerChangeInfoQuery|MajorRiskInfoQuery|CsDdMrInfoQuery|CsPointsGrantInfoQuery|...(20+策略由WorkDetailSimpleFactory路由)
  远程诊断,RemoteDiagnosisWorkOrderDetailStrategy,AbstractRemoteDiagnosisWorkOrderDetailStrategy,CustomerWorkOrderRemoteDiagnosisWorkOrderDetailStrategy|MaintenanceWorkOrderRemoteDiagnosisWorkOrderDetailStrategy|ServiceOrderRemoteDiagnosisWorkOrderDetailStrategy|TechSupportWorkOrderRemoteDiagnosisWorkOrderDetailStrategy

# 工单类型体系（TicketTypeEnum来自soc-api）
ticket_types[19]{type,description,detail_strategy}:
  BOOK_DD_MR,预约到店维保,CarMrsInfoQuery
  BOOK_YD_MR,预约移动维保,CarMrsInfoQuery
  USER_BOOK_DD_MR,用户预约到店维保,CarMrsInfoQuery
  ROAD_RESCUE,道路救援,RoadRescueInfoQuery
  CLAIM,理赔,ClaimInfoQuery
  TEC_SUPPORT,技术支持,TecSupportInfoQuery
  HEALTH_LINK,健康链路,HealthLinkInfoQuery
  ECALL_TSP,紧急呼叫,EcallTspQuery
  THIRD_PERFORMANCE,三方履约,ThirdPerformanceQuery
  CS_ENQUIRE,客服咨询,CsEnquireInfoQuery
  CS_UPDATE,客服升级,CsUpdateInfoQuery
  CS_CONFIRM,客服确认,CsConfirmInfoQuery
  DISPATCH,派工,DispatchInfoQuery
  ECHO_FEEDBACK,回声反馈,EchoFeedbackQuery
  CALLOUT_TASK,外呼任务,CalloutTaskInfoQuery
  CAR_INSPECTION_AUDIT,验车审核,CarInspectionAuditQuery
  CAR_OWNER_CHANGE,车主变更,CarOwnerChangeInfoQuery
  MAJOR_RISK,重大风险,MajorRiskInfoQuery
  CS_DD_MR,客服到店维保,CsDdMrInfoQuery

# 外部依赖（50+ RPC Gateway）
external_system_dependencies:
  CIS整车中心:
    gateways[3]: CisRpcGateway,CisVinVidServiceGateway,CisInsuranceGateway
    usage: 车辆/VIN/保险信息
  car-mrs维保:
    gateways[4]: CarMrsGateway,MrOrderGateway,MrLightGateway,InspectionProviderGateway
    usage: 维保单/环检
  car-soc客服:
    gateways[4]: CsCenterRpcGateway,CswEchoGateway,CswOrderQueryProviderGateway,CswPointGateway
    usage: 客服工单/回声/积分
  理赔系统:
    gateways[1]: ClaimRpcGateway
    usage: 理赔案件
  道路救援:
    gateways[1]: RoadRescueGateway
    usage: 救援工单
  技术支持:
    gateways[2]: TecSupportGateway,RemoteDiagnosisTecSupportGateway
    usage: 技术支持/远程诊断
  投诉管理:
    gateways[2]: ComplaintManageRpcGateway,ComplaintViewGateway
    usage: 投诉信息
  门店系统:
    gateways[2]: StoreProviderGateway,StoreRepairCapacityDataGateway
