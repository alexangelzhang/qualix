metadata:
  service: soc-gw
  domain: 客服系统BFF网关

# API清单（26个Dubbo Provider）
api_entries[26]{id,type,class,methods}:
  API-001,dubbo,SuperTicketProviderImpl,superTicketDetail(超级工单详情查询)|callCenterSuperTicketList(呼叫中心工单列表含并发详情填充)|comstomerSuperTicketList(客户超级工单列表)|storeActualCapacityList(门店在修工单)
  API-002,dubbo,CarAppProviderImpl,getCarList(车主APP车辆列表)|getAppServiceConfig(APP服务配置)|selectStoreListBetaToC(门店列表ToC)
  API-003,dubbo,ServiceOrderQueryProviderImpl,serviceOrderList(服务单列表查询)|serviceOrderDetail(服务单详情)|allServiceOrderList(全量服务单列表)
  API-004,dubbo,StoreRepairCapacityCalculateProviderImpl,getStoreRepairCapacity(门店维修容量计算)
  API-005,dubbo,CswOrderProviderImpl,-
  API-006,dubbo,CswEchoProviderImpl,-
  API-007,dubbo,SuperTicketFollowProviderImpl,-
  API-008,dubbo,SuperTicketLogProviderImpl,-
  API-009,dubbo,WorkOrderRelaProviderImpl,-
  API-010,dubbo,WorkOrderSessionProviderImpl,-
  API-011,dubbo,HealthLinkOrderProviderImpl,-
  API-012,dubbo,RemoteDiagnosisProviderImpl,-
  API-013,dubbo,ComplaintProviderImpl,-
  API-014,dubbo,UrgeProviderImpl,-
  API-015,dubbo,LeadProviderImpl,-
  API-016,dubbo,DispatchProviderImpl,-
  API-017,dubbo,EcallTspProviderImpl,-
  API-018,dubbo,ThirdPerformanceProviderImpl,-
  API-019,dubbo,DepositProviderImpl,-
  API-020,dubbo,CarAccessoryOrderProviderImpl,-
  API-021,dubbo,AgreementProviderImpl,-
  API-022,dubbo,AuthorizationProviderImpl,-
