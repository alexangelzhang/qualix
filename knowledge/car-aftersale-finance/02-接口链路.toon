metadata:
  service: car-aftersale-finance
  domain: 售后财务
  provider_count: 7

# API清单
api_entries[7]{id,type,class,methods}:
  API-001,dubbo,DepositOrderMainProvider,create(创建押金单)|update(更新押金单)|cancel(取消押金单)|depositOrderSearch(搜索列表)|detail(详情)|detailLog(操作日志)|queryItemList(配件列表)|queryWithdrawStatistic(提现统计)|updateUserCheckState(用户确认签字)
  API-002,dubbo,DepositPaymentProvider,receipt(押金收款)|refund(押金退款)|cancelRefund(撤销退款)
  API-003,dubbo,DepositWithdrawalProvider,withdrawal(押金提现)|cancelWithdrawal(撤销提现)
  API-004,dubbo,ClaimSettlementProvider,create(创建理赔单)|save(保存)|submit(提交保司)|deleted(删除)|replenish(补传材料)|check(下钻检查)|checkOutTime(超时校验)|list(列表)|detail(明细)|listWeb(工作台列表)
  API-005,dubbo,InsuranceCallBackProvider,replenishCallBack(补传通知回调)|closeCaseCallBack(结案通知回调)
  API-006,dubbo,DubboHealthProvider,health(健康检查)
  API-007,dubbo,DemoProvider,demo(示例)

# 核心调用链路

# 链路1: 押金单创建（含BPM审批）
call_chain_001:
  name: 押金单创建
  priority: P0
  protection: 门店归属校验+折扣校验+BPM审批(提前交车)
  flow:
    DepositOrderMainProvider.create() [api]:
      DepositOrderMainProviderImpl.create() [app]:
        DepositOrderMainConvert转换 [app/convert]: DTO→GoIn
        DepositOrderService.createDepositOrder() [domain]:
          NoGeneratorRpcGateway.generateDepositOrderNo() [infra/rpc]: 生成押金单号
          EmployeeRpcGateway.checkUserBelongsToShop() [infra/rpc]: 校验门店归属
          checkDepositAmount(): 配件金额校验+折扣比例校验
          DepositOrderGateway.createDepositOrder() [infra]: 押金单+配件关系入库
          FileRemoteGateway.fileCommit() [infra/rpc]: 图片持久化
          提前交车类型→ApprovalInfoGateway.createProcess() [infra/rpc]: 发起BPM审批
          ProcessInstanceGateway.insertSelective() [infra]: 审批流记录入库
          LogRecordGateway.recordOperate() [infra]: 操作日志

# 链路2: 押金单退款（最复杂：BPM审批+订单中台退款+状态机）
call_chain_002:
  name: 押金单退款
  priority: P0
  protection: 状态校验+提现互斥校验+支付时间校验+分布式锁+BPM审批
  flow:
    DepositPaymentProvider.refund() [api]:
      DepositPaymentProviderImpl.refund() [app]:
        DepositPaymentService.ifNeedApply() [domain]: 判断是否需要审批
        需要审批→DepositPaymentService.refundApply() [domain]:
          validateRefund(): 押金状态+提现状态+支付时间三重校验
          createRefundApply():
            NoGeneratorRpcGateway.generateRefundOrderNo() [infra/rpc]: 生成退款单号
            buildRefundTable(): 构建BPM审批表单（押金信息+商品信息+附件）
            ApprovalInfoGateway.createProcess() [infra/rpc]: 发起BPM退款审批
            ProcessInstanceGateway.insertSelective() [infra]: 审批流记录
            RefundRecordGateway.insertSelective() [infra]: 退款单入库
        不需要审批→DepositPaymentService.refund() [domain]:
          Redis分布式锁 [infra]:
          OrderRpcGateway.refundApplyOrder() [infra/rpc]: 订单中台退款
          StateMachine.executeAction(REFUND_EVENT) [domain/statemachine]: 状态→退款中
          ProcessInstanceGateway.updateLatestByEntity() [infra]: 更新审批状态
          LogRecordGateway.recordOperate() [infra]: 操作日志

# 链路3: 押金提现（BPM审批+结算中台+入账户+MQ）
call_chain_003:
  name: 押金提现
  priority: P1
  protection: 门店归属校验+提现/退款互斥校验+分布式锁+BPM审批
  flow:
    DepositWithdrawalProvider.withdrawal() [api]:
      DepositWithdrawalProviderImpl.withdrawal() [app]:
        DepositWithdrawalService.withdrawalApply() [domain]:
          Redis分布式锁 [infra]:
          EmployeeRpcGateway.checkUserBelongsToShop() [infra/rpc]: 门店归属校验
          validateWithdrawal(): 提现状态+押金状态双重校验
          ApprovalInfoGateway.createProcess() [infra/rpc]: 发起BPM提现审批
          ProcessInstanceGateway.insertSelective() [infra]: 审批流记录
        BPM审批通过回调→DepositWithdrawalCallBackHandler.auditAccept() [domain/bpm]:
          DepositWithdrawalService.withdrawal() [domain]:
            OrderRpcGateway.getValidPayOrderDetail() [infra/rpc]: 查支付单号
            SettlementRpcGateway.getCarBill() [infra/rpc]: 查手续费
            SettlementRpcGateway.directWithdrawal() [infra/rpc]: 入账户
            DepositOrderGateway.updateDepositOrder() [infra]: 更新提现状态
            RocketMQGateway.sendMessage() [infra]: 推送清结算消息

# 链路4: 喷漆理赔单提交+保司回调
call_chain_004:
  name: 喷漆理赔单提交+保司回调
  priority: P0
  protection: EventHandler状态流转校验
  flow:
    ClaimSettlementProvider.submit() [api]:
      ClaimSettlementProviderImpl.submit() [app]:
        ClaimSettlementService.submit() [domain]:
          ClaimSettlementStatusEventFactory.getStatusEventHandler(current,SUBMITTED) [domain/factory]:
            SavedToSubmittedStatusTransition.trigger() [domain/factory/strategy]: 状态流转
    InsuranceCallBackProvider.closeCaseCallBack() [api]:
      InsuranceCallBackProviderImpl.closeCaseCallBack() [app]:
        ClaimSettlementService.closeCaseCallBack() [domain]:
          赔付→StatusEventFactory.getStatusEventHandler(current,PASSED) [domain/factory]:
            SubmittedToPassedStatusTransition.trigger(): 状态→已通过
          拒赔→StatusEventFactory.getStatusEventHandler(current,REFUSED) [domain/factory]:
            SubmittedToRefusedStatusTransition.trigger(): 状态→已拒赔
          ApplicationEventPublisher.publishEvent(): 异步消息通知

# 链路5: 订单状态MQ回调（支付/退款/关单）
call_chain_005:
  name: 订单状态MQ回调
  priority: P0
  protection: 订单号校验+状态机校验+分布式锁+重试机制
  flow:
    OrderStatusConsumer.onMessage() [app/mq]:
      支付完成→OrderCallBack.payOrderCallBack() [domain]:
        Redis分布式锁 [infra]:
        OrderRpcGateway.getOrderDetail() [infra/rpc]: 查订单详情（含重试3次）
        StateMachine.executeAction(RECEIPT_EVENT) [domain/statemachine]: 状态→已收款
        updatePayTime(): 更新支付时间到扩展字段
      退款完成→OrderCallBack.refundOrderCallBack() [domain]:
        StateMachine.executeAction(REFUND_RECEIVE) [domain/statemachine]: 状态→已退款
      关单→OrderCallBack.closeOrderCallBack() [domain]:
        StateMachine.executeAction(CANCEL_EVENT) [domain/statemachine]: 状态→已取消

# 状态机定义

state_machines:
  deposit_order[6]{state,code,description}:
    INITIAL,-1,初始化（状态机起始状态）
    ALREADY_CREATE,0,已创建
    WAITING_RECEIPT,1,待收款
    ALREADY_RECEIPT,2,已收款
    REFUNDING,3,退款中
    ALREADY_REFUND,4,已退款
    ALREADY_CANCEL,5,已取消
  deposit_events[6]{event,description}:
    CREATE_EVENT,创建押金单
    CONFIRM_RECEIPT_EVENT,确认收款
    RECEIPT_EVENT,收款
    REFUND_EVENT,退款
    REFUND_RECEIVE,退款到账
    CANCEL_EVENT,取消押金单
  deposit_note: 自研StateMachine<S,E,C>框架，StateMachineBuilder按事件分组Transition，AbstractStateMachineHandler默认action更新押金单状态

  claim_settlement[7]{state,code,description}:
    SAVED,0,待提交
    SUBMITTED,1,待审核
    REJECTED,2,已驳回
    PASSED,3,已通过
    DELETED,4,已删除
    DISCARDED,5,已废弃
    REFUSED,6,已拒赔
  claim_settlement_transitions[11]{from,to,handler}:
    null,SAVED(0),EmptyToSavedStatusTransition
    SAVED(0),SAVED(0),SavedToSavedStatusTransition
    SAVED(0),SUBMITTED(1),SavedToSubmittedStatusTransition
    SAVED(0),DELETED(4),SavedToDeletedStatusTransition
    SAVED(0),DISCARDED(5),SavedToDiscardedStatusTransition
    REJECTED(2),SUBMITTED(1),RejectedToSubmittedStatusTransition
    REJECTED(2),PASSED(3),RejectedToPassedStatusTransition
    REJECTED(2),DISCARDED(5),RejectedToDiscardedStatusTransition
    SUBMITTED(1),REJECTED(2),SubmittedToRejectedStatusTransition
    SUBMITTED(1),PASSED(3),SubmittedToPassedStatusTransition
    SUBMITTED(1),REFUSED(6),SubmittedToRefusedStatusTransition
  claim_settlement_note: ClaimSettlementStatusEventFactory按source-target路由到对应StatusTransition策略

# Gateway清单
gateway_summary:
  db_gateways[11]: DepositOrderGateway|ClaimSettlementOrderGateway|CouponSettlementGateway|LogRecordGateway|ProcessInstanceGateway|RefundRecordGateway|DemoGateway|+4more
  rpc_gateways[18]: OrderRpcGateway|BuyRpcGateway|SettlementRpcGateway|EmployeeRpcGateway|SelectListRpcGateway|GoodsServiceRpcGateway|MroPolicyRpcGateway|NoGeneratorRpcGateway|FileRemoteGateway|ApprovalInfoGateway|CarInfoGateway|CarMrsGateway|CarOrgGateway|DirectClaimAckGateway|ServicePackageGateway|AppPushGateway|UPCRemoteGateway|QianKunUploadGateway
  http_gateways[2]: PingAnHttpGateway|PingAnIobsGateway（平安保司对接）
  mq_gateways[1]: RocketMQGateway（清结算消息推送）
