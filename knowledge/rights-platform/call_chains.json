{
  "project_id": "rights-platform",
  "call_chains": [
    {
      "chain_id": "refund-main",
      "module": "退款",
      "name": "权益包退款主链路",
      "trigger": "用户/客服/定时任务",
      "layers": [
        {"layer": "admin.Provider", "class": "ServicePackageRefundProviderImpl.servicePackageRefund()"},
        {"layer": "admin.DomainService", "class": "PackageRefundDomainService.refund()"},
        {"layer": "admin.Gateway", "class": "PackageRefundCenterGatewayImpl.refund() [防腐层, Dubbo RPC]"},
        {"layer": "center.Provider", "class": "PackageRefundProviderImpl.refund()"},
        {"layer": "center.CmdExe", "class": "PackageRefundCmdExe.execute()"},
        {"layer": "center.DomainService", "class": "PackageRefundService.refund()"},
        {"layer": "center.TMF", "class": "TMF.execute(chainId='CnCar_packageRefund')", "steps": [
          {"step": 1, "class": "RefundParamParseStep", "desc": "参数解析校验"},
          {"step": 2, "class": "DuplicateRefundCheckStep", "desc": "幂等检查", "ability": "DuplicateCheckAbility", "extension": "RefundDuplicateCheckExt"},
          {"step": 3, "class": "EquityInfoQueryStep", "desc": "查询权益信息", "ability": "EquityInfoQueryAbility"},
          {"step": 4, "class": "RefundRuleQueryStep", "desc": "退款规则查询", "ability": "RefundRuleQueryAbility"},
          {"step": 5, "class": "RefundLimitCheckStep", "desc": "退款限制校验(7天窗口/使用状态)", "ability": "RefundLimitCheckAbility"},
          {"step": 6, "class": "RefundAmountCalculateStep", "desc": "退款金额计算", "ability": "RefundAmountCalculateAbility"},
          {"step": 7, "class": "BpmApprovalStartStep", "desc": "BPM审批发起", "ability": "BpmApprovalStartAbility"},
          {"step": 8, "class": "RefundRecordSaveStep", "desc": "退款记录保存", "ability": "RefundRecordSaveAbility"},
          {"step": 9, "class": "RefundingStatusUpdateStep", "desc": "权益状态→退款中", "ability": "EquityRecordValidStatusUpdateAbility"},
          {"step": 10, "class": "VoucherRecallStep", "desc": "凭证回收", "ability": "VoucherRecallAbility", "extension": "reduceExtensions模式"},
          {"step": 11, "class": "PostRecallActionStep", "desc": "回收后置动作(积分补偿)", "ability": "PostRecallActionAbility"},
          {"step": 12, "class": "OrderRefundStep", "desc": "订单退款", "ability": "OrderRefundAbility", "extension": "firstExtension模式"}
        ]}
      ],
      "protection_points": [
        {"type": "lock", "layer": "DomainService", "impl": "SerializableIsolationAbility.acquireLock()", "detail": "Redis分布式锁, lockKey=orderId"},
        {"type": "idempotent", "layer": "TMF.Step2", "impl": "DuplicateRefundCheckStep → RefundDuplicateCheckExt", "detail": "idempotentId=orderId_packageIssueId, 状态REFUNDING/SUCCESS时拦截"},
        {"type": "transaction", "layer": "TMF.Step8", "impl": "RefundRecordSaveAbility.saveRecords() @Transactional", "detail": "package_cancel_record + equity_cancel_record 原子写入"},
        {"type": "state_validation", "layer": "TMF.Step5", "impl": "RefundLimitCheckAbility", "detail": "7天时间窗口/权益使用状态校验"}
      ]
    },
    {
      "chain_id": "refund-vid-batch",
      "module": "退款",
      "name": "VID批量作废(退换车场景)",
      "trigger": "退换车事件",
      "layers": [
        {"layer": "center.CmdExe", "class": "PackageRefundCmdExe.executeBatchByVid()"},
        {"layer": "center.DomainService", "class": "PackageRefundService.listActivePackagesByVid() → for each → refund()"}
      ],
      "protection_points": [
        {"type": "lock", "layer": "DomainService", "impl": "每条复用主链路分布式锁", "detail": "逐条串行处理"}
      ],
      "known_issues": ["部分失败不可回滚(EXC-001)"]
    },
    {
      "chain_id": "refund-bpm-callback",
      "module": "退款",
      "name": "BPM审批回调",
      "trigger": "BPM系统回调",
      "layers": [
        {"layer": "admin.Provider", "class": "ServicePackageRefundProviderImpl.refundBpmCallBack()"},
        {"layer": "admin.Gateway", "class": "PackageRefundCenterGatewayImpl.refundBpmCallBack()"},
        {"layer": "center.CmdExe", "class": "RefundBpmCallbackCmdExe.execute()"},
        {"layer": "center.DomainService(Accept)", "class": "PackageRefundService.executeAfterBpmApproveCancel() → TMF(bpmApproveCancel)"},
        {"layer": "center.Ability(Refuse)", "class": "BpmRejectAbility.rejectRefund() [绕过TMF]"},
        {"layer": "center.CmdExe(Cancel)", "class": "CancelRefundCmdExe.execute() [复用取消链路]"}
      ],
      "protection_points": [],
      "known_issues": ["Accept/Refuse/Cancel均无分布式锁(NEW-002)", "BpmRejectAbility绕过TMF步骤链(ARCH-008)"]
    },
    {
      "chain_id": "refund-cancel",
      "module": "退款",
      "name": "取消退款",
      "trigger": "用户/客服取消",
      "layers": [
        {"layer": "center.CmdExe", "class": "CancelRefundCmdExe.execute()"},
        {"layer": "center.DomainService", "class": "PackageRefundCancelService.cancel()"},
        {"layer": "center.Ability", "class": "CancelRefundAbility.cancel() [绕过TMF, 直接编排]"}
      ],
      "protection_points": [
        {"type": "state_validation", "layer": "Ability", "impl": "校验status==REFUNDING && idempotentId非空", "detail": ""}
      ],
      "known_issues": ["无分布式锁(NEW-002)", "restoreEquityValid异常被吞(NEW-005)", "绕过TMF步骤链(ARCH-007)"]
    },
    {
      "chain_id": "refund-completion",
      "module": "退款",
      "name": "退款完成消息处理",
      "trigger": "MQ: 订单退款完成消息",
      "layers": [
        {"layer": "admin.MQ", "class": "OrderRefundResultConsumer.onMessage()"},
        {"layer": "admin.Gateway", "class": "PackageRefundCenterGatewayImpl.handleRefundCompletion()"},
        {"layer": "center.Provider", "class": "PackageRefundProviderImpl.handleRefundCompletion()"},
        {"layer": "center.DomainService", "class": "PackageRefundCompletionService.handleRefundCompletion()"},
        {"layer": "center.TMF", "class": "TMF.execute(chainId='CnCar_refundCompletion')", "steps": [
          {"step": 1, "class": "RefundCompletionParamParserStep", "desc": "参数校验"},
          {"step": 2, "class": "RefundCompletionInfoQueryStep", "desc": "查退款记录+发放记录"},
          {"step": 3, "class": "RefundCompletedStatusUpdateStep", "desc": "状态更新(新旧库双写)"}
        ]}
      ],
      "protection_points": [
        {"type": "lock", "layer": "DomainService", "impl": "SerializableIsolationAbility.acquireLock()", "detail": "Redis分布式锁"},
        {"type": "transaction", "layer": "TMF.Step3", "impl": "RefundCompletedStatusUpdateAbility @Transactional", "detail": ""}
      ],
      "known_issues": ["新旧库双写不在同一事务(EXC-002/DATA-003)", "pOrderId为空时静默丢弃(EXC-004)"]
    },
    {
      "chain_id": "refund-expired-auto",
      "module": "退款",
      "name": "到期自动退款(定时任务)",
      "trigger": "定时任务",
      "layers": [
        {"layer": "admin.Provider", "class": "AdminPackageRefundTaskProviderImpl"},
        {"layer": "admin.Service", "class": "PackageRefundTaskService.executeExpiredRefundTask()"},
        {"layer": "admin.DomainService", "class": "PackageRefundDomainService.refund() [refundSource=AUTO, 复用主链路]"}
      ],
      "protection_points": [
        {"type": "config_switch", "layer": "Service", "impl": "NacosConfig.isAutoRefundTaskEnabled()", "detail": "Nacos开关"}
      ]
    },
    {
      "chain_id": "query-package-detail",
      "module": "查询",
      "name": "Pad/客服权益详情查询",
      "trigger": "Pad/客服工作台",
      "layers": [
        {"layer": "center.Provider", "class": "PackageInfoProviderImpl.getPackageDetail()"},
        {"layer": "center.CmdExe", "class": "PackageListQueryCmdExe.execute()"},
        {"layer": "center.DomainService", "class": "PackageInfoService.getPackageList()"},
        {"layer": "center.TMF", "class": "TMF.execute()", "steps": [
          {"step": 1, "class": "PackageListQueryParamParserStep", "desc": "参数解析(vid必填)"},
          {"step": 2, "class": "PersonVehicleRelationCheckStep", "desc": "人车关系校验"},
          {"step": 3, "class": "ValidPackageInfoQueryStep", "desc": "查询有效权益包"},
          {"step": 4, "class": "LocalEquityQueryStep", "desc": "查询本地权益发放记录"},
          {"step": 5, "class": "ExpiredEquityFilterStep", "desc": "过期权益过滤"},
          {"step": 6, "class": "TransferEquityTypeStep", "desc": "权益类型转换"},
          {"step": 7, "class": "EquityEnrichmentStep", "desc": "权益信息丰富(配置+展示)"},
          {"step": 8, "class": "EquityStNosProcessStep", "desc": "NOS图片处理"},
          {"step": 9, "class": "ExtendInfoEnrichStep", "desc": "扩展信息丰富"},
          {"step": 10, "class": "VipEquityQueryStep", "desc": "VIP权益查询"},
          {"step": 11, "class": "CarItemDetailSetStep", "desc": "车辆详情设置"}
        ]}
      ],
      "protection_points": []
    },
    {
      "chain_id": "query-equity-display-config",
      "module": "查询",
      "name": "权益展示配置查询",
      "trigger": "多端展示",
      "layers": [
        {"layer": "center.Provider", "class": "EquityConfigProviderImpl.queryEquityDisplayConfig()"},
        {"layer": "center.CmdExe", "class": "EquityDisplayConfigQueryCmdExe.execute()"},
        {"layer": "center.DomainService", "class": "EquityDisplayConfigService.queryEquityDisplayConfig()"},
        {"layer": "center.TMF", "class": "TMF链路(查询展示配置)"}
      ],
      "protection_points": []
    },
    {
      "chain_id": "query-equity-content",
      "module": "查询",
      "name": "权益展示内容查询",
      "trigger": "车辆档案/APP",
      "layers": [
        {"layer": "center.Provider", "class": "EquityConfigProviderImpl.getEquityContent()"},
        {"layer": "center.CmdExe", "class": "EquityContentQueryCmdExe.execute()"},
        {"layer": "center.TMF", "class": "TMF(activity=equityContentQuery)", "steps": [
          {"step": 1, "class": "EquityContentQueryParamParserStep"},
          {"step": 2, "class": "EquityContentEquityNameQueryStep"},
          {"step": 3, "class": "EquityContentDisplayConfigQueryStep"}
        ]}
      ],
      "protection_points": []
    }
  ]
}
