service_info:
  name: proretail-customer-care
  domain: 售后善意关怀/权益发放
  description: 小米汽车售后善意关怀系统，支持门店通过维保工单或客诉单向车主发放积分权益，覆盖积分申请、BPM多级审批、积分发放、导出的完整业务闭环
  tech_stack[8]:
    Java 8 / Spring Boot 2.7.7
    Dubbo RPC（MSF-Mesh 边车模式，sautumnn 框架）
    MyBatis + MySQL（读写分离：customer_care_read / customer_care_write）
    Redis（幂等控制、防重复提交）
    BPM 审批流（积分金额分档审批）
    EasyExcel（导出）/ NrJob（异步任务）
    Nacos（配置中心）
    MapStruct + Lombok
  core_responsibilities[4]:
    积分权益申请（客诉单/维保单双入口）
    BPM 多级审批（6档积分阈值路由不同审批链路）
    积分自动发放（审批通过后触发积分系统发放）
    积分发放记录导出（异步Job+EasyExcel+水印）

service_boundaries:
  owns[5]{capability,description}:
    积分发放生命周期,申请-审批-发放-完成全流程管理
    BPM审批集成,创建审批/执行审核/回调处理
    发放场景配置,场景类型二级树管理
    操作日志,发放操作全链路日志记录
    积分导出,异步导出+EasyExcel+水印
  delegates_to[8]{service,capability,usage}:
    积分系统 Aries,积分批次查询/积分发放,AriesGateway
    BPM 审批系统,创建审批/执行审核/查询任务,BpmGateway
    维保系统 car-mrs,查询维保工单信息,MrsGateway
    客诉系统 complaint-manage,查询客诉单/写入积分记录,ComplaintGateway
    员工系统 EIAM,员工信息查询,EmployeeGateway
    门店系统,门店信息查询,StoreDataGateway
    文件服务,文件上传/下载/提交,FileRpcGateway
    异步任务中心 NrJob,触发导出任务,NrJobGateway
  provides_to[0]{service,capability,interface}:

ddd_layers[5]{layer,module,responsibility,scale}:
  API契约层,proretail-customer-care-api,5个Provider接口+DTO/Req/Resp,纯接口定义
  应用层,proretail-customer-care-app,5个ProviderImpl+1个Job+2个Convert,编排协调
  领域层,proretail-customer-care-domain,1个Service+11个Gateway接口+3枚举+15+Entity,核心业务
  基础设施层,proretail-customer-care-infrastructure,11个GatewayImpl+4个Mapper+4个DO+8个Convert,DB/RPC
  启动层,proretail-customer-care-server,Spring Boot启动+配置,启动入口

scale_stats:
  provider_count: 5
  domain_service_count: 1
  gateway_count: 11
  gateway_impl_count: 11（4个DB+7个RPC）
  mapper_count: 4
  main_code_files: 117
  test_files: 23

scenarios:
  P0[2]{id,entry_class,name,trigger,desc}:
    SC-001,RightsDistributionProviderImpl,积分发放提交,dubbo,客诉/维保双入口+Redis幂等+BPM分档审批+近7天汇总（最复杂链路）
    SC-002,BpmCallbackProviderImpl,BPM审批回调,dubbo,审批通过自动触发积分发放+幂等ID保证不重复
  P1[2]{id,entry_class,name,trigger,desc}:
    SC-003,RightsDistributionProviderImpl,手动审核,dubbo,BPM任务审核+审核人校验
    SC-004,RightsDistributionProviderImpl,积分导出,dubbo,异步Job+EasyExcel+水印
  P2[1]{id,entry_class,name,trigger,desc}:
    SC-005,RightsSceneProviderImpl,场景查询,dubbo,简单DB查询发放场景配置

state_machine:
  name: DistributeStatusEnum
  states[9]:
    WAIT_SUBMIT(1)
    WAIT_AUDIT(2)
    AUDITING(3)
    AUDIT_PASS(4)
    AUDIT_REJECT(5)
    WAIT_DISTRIBUTE(6)
    DISTRIBUTE_SUCCESS(7)
    DISTRIBUTE_FAIL(8)
    FINISHED(9)
  transitions[6]{from,event,to}:
    WAIT_SUBMIT,提交,AUDITING
    AUDITING,通过,AUDIT_PASS→WAIT_DISTRIBUTE
    AUDITING,驳回,AUDIT_REJECT
    AUDIT_REJECT,重新编辑提交,AUDITING
    WAIT_DISTRIBUTE,发放成功,DISTRIBUTE_SUCCESS→FINISHED
    WAIT_DISTRIBUTE,发放失败,DISTRIBUTE_FAIL→FINISHED

architecture_assessment:
  grade: B+（小型项目，分层清晰但领域建模偏薄）
  strengths[5]:
    分层依赖方向正确（API纯接口/Domain定义Gateway/Infrastructure实现/依赖倒置）
    读写分离设计规范（@Resource区分read/write Mapper）
    Gateway抽象合理（11个Gateway覆盖所有外部依赖，统一错误处理模式）
    审批流程设计完整（6档阈值路由+回调自动发放+幂等ID+近7天汇总）
    Convert层次分明（App层Req/Resp↔Entity + Infra层Entity↔DO，MapStruct自动生成）
  risks[7]{id,severity,description}:
    R-001,High,RightsDistributionService 836行God Service，承担提交/审核/回调/导出/删除/查询全部职责
    R-002,High,Domain Service直接依赖API层DTO（import api.model.req/resp），破坏分层隔离
    R-003,Medium,RightsDistributionEntity贫血模型，状态校验逻辑散落在Service中
    R-004,Medium,Redis幂等expireTime被硬编码覆盖为"60"（第342行），Nacos配置失效
    R-005,Medium,BPM创建与DB更新非原子操作，存在状态不一致风险
    R-006,Medium,assignPoint异常静默catch，可能导致发放状态与实际不一致
    R-007,Low,部分App层ProviderImpl直接注入Gateway跳过Domain Service

scheduled_jobs[1]{id,name,cron,class}:
  JOB-001,积分导出,按需触发（NrJob）,DistributionExportJobHandler
